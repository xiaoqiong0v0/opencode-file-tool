{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": false,
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["*.ts", "tools/*.ts"],
  "exclude": ["node_modules", "dist", ".tmp"]
}
